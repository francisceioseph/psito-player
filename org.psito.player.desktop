[Desktop Entry]
Type=Application
Name=Psito Player
GenericName=Music Player
GenericName[pt]=Player de música
GenericName[es]=Reproductor de música
GenericName[fr]=Lecteur de musique
GenericName[de]=Musikplayer
GenericName[ru]=Музыкальный плеер
GenericName[zh]=音乐播放器
Comment=Play your local music, with synced lyrics
Comment[pt]=Toque as suas músicas locais, com letras sincronizadas
Comment[es]=Reproduce tu música local, con letras sincronizadas
Comment[fr]=Écoutez votre musique locale, avec paroles synchronisées
Comment[de]=Spiele deine lokale Musik ab, mit synchronisierten Liedtexten
Comment[ru]=Слушайте свою музыку с синхронизированными текстами
Comment[zh]=播放本地音乐，支持同步歌词
Exec=psito_player %F
Icon=org.psito.player
Terminal=false
Categories=AudioVideo;Audio;Player;
StartupWMClass=org.psito.player
MimeType=audio/flac;audio/x-flac;audio/mpeg;audio/ogg;audio/x-vorbis+ogg;audio/opus;audio/x-opus+ogg;audio/mp4;audio/x-m4a;audio/wav;audio/x-wav;audio/aac;audio/x-aac;audio/x-ms-wma;audio/x-ape;audio/x-wavpack;audio/x-aiff;audio/aiff;
