[Desktop Entry]
Type=Application
Name=Psito Player
GenericName=Music Player
GenericName[pt]=Player de música
Comment=Play your local music, with synced lyrics
Comment[pt]=Toque as suas músicas locais, com letras sincronizadas
Exec=psito_player %F
Icon=org.psito.player
Terminal=false
Categories=AudioVideo;Audio;Player;
StartupWMClass=org.psito.player
MimeType=audio/flac;audio/x-flac;audio/mpeg;audio/ogg;audio/x-vorbis+ogg;audio/opus;audio/x-opus+ogg;audio/mp4;audio/x-m4a;audio/wav;audio/x-wav;
